    newRow.innerHTML = "\n    <td>".concat(date.name, "</td>\n    <td>").concat(date.position, "</td>\n    <td>").concat(date.office, "</td>\n    <td>").concat(Number(date.age), "</td>\n    <td>$").concat(salaryToNumber, "</td>\n  ");
