function validateForm(date) {
    var nameElement = document.getElementById("name");
    var ageElement = document.getElementById("age");
    var positionElement = document.getElementById("position");
    var isValid = true;
    var nameValue = date.name.trim();
    var positionValue = date.position.trim();
    var ageValue = Number(date.age.trim());
    if (nameValue.length < 4) {
        showError(nameElement, "Name must be at least 4 characters long");
        isValid = false;
    }
    if (ageValue < 18 || ageValue > 90) {
        showError(ageElement, "Age must be between 18 and 90");
        isValid = false;
    }
    if (positionValue.length === 0) {
        showError(positionElement, "Position is required");
        isValid = false;
    }
    if (isValid) {
        showNotification("Employee added successfully", "Employee added successfully", "success");
        formNew.reset();
        var errorDiv = formNew.querySelectorAll(".error");
        errorDiv.forEach(function(el) {
            return el.textContent = "";
        });
        addNewUser(date);
    } else showNotification("Please correct the errors above", "Please correct the errors above", "error");
}
function showError(input, message) {
    var errorDiv = input.parentElement.nextElementSibling;
    errorDiv.textContent = message;
}
function showNotification(message, description, type) {
    var notification = document.createElement("div");
    var titleEl = document.createElement("h2");
    var descriptionEl = document.createElement("p");
    notification.setAttribute("class", "notification ".concat(type));
    notification.setAttribute("data-qa", "notification");
    titleEl.textContent = message;
    titleEl.setAttribute("class", "title");
    descriptionEl.textContent = description;
    notification.appendChild(titleEl);
    notification.appendChild(descriptionEl);
    document.body.appendChild(notification);
    setTimeout(function() {
        return notification.remove();
    }, 4000);
}
